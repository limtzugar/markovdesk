# Database (SQLite — no setup needed, file is created automatically)
DATABASE_URL="file:./db/custom.db"

# --- LLM Providers ---
# Default is GLM (via z-ai-web-dev-sdk, works in Z.ai sandbox without a key).
# On your own PC, set ONE of the following to use a different provider.

# DeepSeek (recommended for trading reflection — deepseek-reasoner uses chain-of-thought)
# Get key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI-compatible (works with OpenAI, OpenRouter, Together, Groq, etc.)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
